# MatchMyResume Backend Environment Configuration

# Optional: Google Gemini API Key for Generative AI Insights and Interactive Chat
# If left empty, the application automatically uses deterministic contextual AI synthesis.
GEMINI_API_KEY=

# Gemini Model identifier (e.g., gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Server Port
PORT=8001
